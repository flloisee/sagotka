# SMTP for OTP emails via Gmail App Passwords.
# Setup: Google Account → Security → enable 2-Step Verification → App passwords →
# create one for "Mail" and copy the 16-character password. App passwords only work
# on the account that owns them, so SMTP_USER must be that Gmail address and SMTP_FROM
# uses the same address (Gmail rewrites From to the authenticated sender).
# When unset, OTP codes are logged to the server console instead of emailed.
# Login always requires a code (fail closed); in production with SMTP unset,
# login is refused entirely. OTP request/verify responses are intentionally
# identical for existing and unknown accounts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=<16-character app password>
SMTP_FROM=SagotKa <you@gmail.com>

# Optional comma-separated list of extra origins allowed by CORS.
# CORS_ORIGINS=https://forms.example.com,https://forms.example.org
